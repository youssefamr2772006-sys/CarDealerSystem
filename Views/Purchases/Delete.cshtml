@model CarDealerSystem.Models.Entities.Purchase

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="page-header">
    <div class="page-title-group">
        <div class="page-eyebrow">Purchases</div>
        <h2>Delete Purchase</h2>
    </div>
</div>

<div class="panel-card">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="metric-icon-badge tint-danger mb-0">
            <i data-lucide="triangle-alert"></i>
        </div>
        <div>
            <h3 class="mb-1">Delete this purchase?</h3>
            <span style="font-size: var(--fs-helper); color: var(--text-muted);">
                This action is permanent and cannot be undone.
            </span>
        </div>
    </div>

    <div class="definition-grid mb-4">

        <div class="definition-row">
            <span class="definition-label">Car</span>
            <span class="definition-value">@Model.Car?.Brand @Model.Car?.Model</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Supplier</span>
            <span class="definition-value">@Model.Supplier?.CompanyName</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Employee</span>
            <span class="definition-value">@Model.Employee?.ApplicationUser?.FullName</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Purchase Date</span>
            <span class="definition-value">@Model.PurchaseDate.ToShortDateString()</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Purchase Price</span>
            <span class="definition-value">@Model.PurchasePrice.ToString("C")</span>
        </div>

    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-action="Delete" method="post" class="form-footer justify-content-start">

        <input asp-for="Id" type="hidden" />

        <a asp-action="Index" class="btn btn-secondary">
            <i data-lucide="arrow-left"></i>
            Cancel
        </a>

        <button type="submit" class="btn btn-danger">
            <i data-lucide="trash-2"></i>
            Delete Purchase
        </button>

    </form>

</div>
