@model CarDealerSystem.Models.Entities.Branch

@{
    ViewData["Title"] = "Branch Details";
}

<div class="page-header">
    <div class="page-title-group">
        <div class="page-eyebrow">Branches</div>
        <h2>@Model.Name</h2>
    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i data-lucide="pencil"></i>
        Edit
    </a>
</div>

<div class="panel-card">

    <div class="panel-header">

        <div class="panel-icon-badge">
            <i data-lucide="building-2"></i>
        </div>

        <div>
            <h3 class="mb-1">@Model.Name</h3>
        </div>

    </div>

    <div class="definition-grid">

        <div class="definition-row">
            <span class="definition-label">Name</span>
            <span class="definition-value">@Model.Name</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">City</span>
            <span class="definition-value">@Model.City</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Address</span>
            <span class="definition-value">@Model.Address</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Phone</span>
            <span class="definition-value">@Model.Phone</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Employees</span>
            <span class="definition-value">@(Model.Employees?.Count ?? 0)</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Cars</span>
            <span class="definition-value">@(Model.Cars?.Count ?? 0)</span>
        </div>

    </div>

</div>

<a asp-action="Index" class="btn btn-secondary mt-3">
    <i data-lucide="arrow-left"></i>
    Back
</a>
