@model IEnumerable<CarDealerSystem.Models.Entities.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-header">

    <div class="page-title-group">
        <div class="page-eyebrow">@Model.Count() employees</div>
        <h2>Employees</h2>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i data-lucide="plus"></i>
        Add Employee
    </a>

</div>

<div class="table-responsive">

    <table class="table table-bordered table-hover">

        <thead class="table-dark">

            <tr>

                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th class="text-end">Salary</th>
                <th>Branch</th>
                <th width="140" class="text-center">Actions</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td class="fw-semibold">@item.ApplicationUser?.FullName</td>

                    <td>@item.ApplicationUser?.Email</td>

                    <td>@item.ApplicationUser?.PhoneNumber</td>

                    <td class="num">@item.Salary.ToString("C")</td>

                    <td>@item.Branch?.Name</td>

                    <td class="text-center">

                        <div class="row-actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-ghost btn-icon"
                               title="View" aria-label="View">
                                <i data-lucide="eye"></i>
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-ghost btn-icon"
                               title="Edit" aria-label="Edit">
                                <i data-lucide="pencil"></i>
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger-ghost btn-icon"
                               title="Delete" aria-label="Delete">
                                <i data-lucide="trash-2"></i>
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
