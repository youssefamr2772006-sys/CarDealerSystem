@model CarDealerSystem.Models.Entities.Service

@{
    ViewData["Title"] = "Add Service";
}

<div class="page-header">
    <div class="page-title-group">
        <div class="page-eyebrow">Services</div>
        <h2>New Service</h2>
    </div>
</div>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-section">
        <div class="form-section-title">
            <i data-lucide="wrench"></i>
            Service Details
        </div>

        <div class="row">

            <div class="col-md-6 mb-3">

                <label asp-for="CarId" class="form-label">Car</label>

                <select asp-for="CarId"
                        asp-items="ViewBag.Cars"
                        class="form-select">
                    <option value="">-- Select Car --</option>
                </select>

                <span asp-validation-for="CarId" class="text-danger"></span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="EmployeeId" class="form-label">Employee</label>

                <select asp-for="EmployeeId"
                        asp-items="ViewBag.Employees"
                        class="form-select">
                    <option value="">-- Select Employee --</option>
                </select>

                <span asp-validation-for="EmployeeId" class="text-danger"></span>

            </div>

            <div class="col-md-12 mb-3">

                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Description" class="text-danger"></span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="Cost" class="form-label"></label>

                <input asp-for="Cost"
                       class="form-control" />

                <span asp-validation-for="Cost" class="text-danger"></span>

            </div>

        </div>
    </div>

    <div class="form-footer">

        <a asp-action="Index" class="btn btn-secondary">
            <i data-lucide="arrow-left"></i>
            Back
        </a>

        <button type="submit" class="btn btn-success">
            <i data-lucide="check-circle"></i>
            Save Service
        </button>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
