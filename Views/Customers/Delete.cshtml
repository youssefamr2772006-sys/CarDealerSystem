@model CarDealerSystem.Models.Entities.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="page-header">
    <div class="page-title-group">
        <div class="page-eyebrow">Customers</div>
        <h2>Delete Customer</h2>
    </div>
</div>

<div class="panel-card">

    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="metric-icon-badge tint-danger mb-0">
            <i data-lucide="triangle-alert"></i>
        </div>
        <div>
            <h3 class="mb-1">Delete this customer?</h3>
            <span style="font-size: var(--fs-helper); color: var(--text-muted);">
                This action is permanent and cannot be undone.
            </span>
        </div>
    </div>

    <div class="definition-grid mb-4">

        <div class="definition-row">
            <span class="definition-label">Full Name</span>
            <span class="definition-value">@Model.FullName</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Phone</span>
            <span class="definition-value">@Model.Phone</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Email</span>
            <span class="definition-value">@Model.Email</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">Address</span>
            <span class="definition-value">@Model.Address</span>
        </div>

        <div class="definition-row">
            <span class="definition-label">National ID</span>
            <span class="definition-value">@Model.NationalId</span>
        </div>

    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-action="Delete" method="post" class="form-footer justify-content-start">

        <input asp-for="Id" type="hidden" />

        <a asp-action="Index" class="btn btn-secondary">
            <i data-lucide="arrow-left"></i>
            Cancel
        </a>

        <button type="submit" class="btn btn-danger">
            <i data-lucide="trash-2"></i>
            Delete Customer
        </button>

    </form>

</div>
